<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stock Trading App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0f172a, #111827);
            color: #f8fafc;
            min-height: 100vh;
        }
        .hero {
            padding-top: 120px;
        }
        .glass {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.3);
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Stock Trading App</a>
            <div class="ms-auto d-flex gap-2">
                <a class="btn btn-outline-light" href="/login">Login</a>
                <a class="btn btn-primary" href="/register">Register</a>
            </div>
        </div>
    </nav>

    <div class="container hero">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3">Track the market with confidence.</h1>
                <p class="lead text-secondary mb-4">
                    Monitor stocks, manage a portfolio, and stay on top of your watchlist from one app.
                </p>
                <div class="d-flex gap-3">
                    <a class="btn btn-primary btn-lg" href="/register">Create account</a>
                    <a class="btn btn-outline-light btn-lg" href="/login">Sign in</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="glass p-4">
                    <h4 class="mb-3">Market snapshot</h4>
                    <div class="mb-3">
                        <div class="text-secondary small">AAPL</div>
                        <div class="fs-3 fw-bold">$214.87</div>
                        <div class="text-success">+1.82%</div>
                    </div>
                    <div class="mb-3">
                        <div class="text-secondary small">MSFT</div>
                        <div class="fs-3 fw-bold">$429.44</div>
                        <div class="text-success">+0.96%</div>
                    </div>
                    <div>
                        <div class="text-secondary small">NVDA</div>
                        <div class="fs-3 fw-bold">$128.73</div>
                        <div class="text-success">+2.41%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
